{
  "manifest_version": 3,
  "name": "Play in mpv",
  "version": "1.0",
  "description": "Detects HLS (.m3u8) streams on the page and plays them in mpv with hardware decoding.",
  "key": "",
  "permissions": ["webRequest", "storage", "nativeMessaging", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Play in mpv", "default_popup": "popup.html" }
}
